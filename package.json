{
  "name": "starrail-landlord",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "A mobile-ready Star Rail themed slot deckbuilding roguelike",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "build:portable": "node scripts/build-portable.mjs",
    "check": "node scripts/check.mjs",
    "balance": "node scripts/balance-parallel.mjs",
    "train:ai": "node scripts/train-ai.mjs",
    "balance:growth": "node scripts/growth-balance.mjs",
    "matrix:preflight": "node scripts/verify-player-matrix-preflight.mjs",
    "matrix:standard": "node --max-old-space-size=8192 scripts/run-player-matrix-standard.mjs",
    "matrix:status": "node scripts/player-matrix-status.mjs",
    "matrix:analyze": "node --max-old-space-size=8192 scripts/analyze-player-matrix.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
